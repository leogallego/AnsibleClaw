---
# playbook.yml -- Composite playbook for {{ skill_name | replace('_', ' ') }}
# Generated by AnsibleClaw (compose)
#
# Usage:
#   ansible-playbook assets/playbook.yml -i /path/to/inventory.yml --check --diff
#   ansible-playbook assets/playbook.yml -i /path/to/inventory.yml --diff
#
- name: "{{ description }}"
  hosts: all
  become: true
{% if collection_fqcns %}
  collections:
{% for coll in collection_fqcns %}
    - {{ coll }}
{% endfor %}
{% endif %}
  tasks:
{% for m in modules %}
    - name: "{{ m.short_description }}"
      {{ m.module_name }}:
{% if m.get('prefilled_vars') %}
{% for key, val in m['prefilled_vars'].items() %}
{% if val is string %}
        {{ key }}: "{{ val }}"
{% elif val is sameas true %}
        {{ key }}: true
{% elif val is sameas false %}
        {{ key }}: false
{% else %}
        {{ key }}: {{ val }}
{% endif %}
{% endfor %}
{% else %}
{% for p in m.params if p.required %}
{% if p.choices %}
        {{ p.name }}: {{ p.choices[0] }}
{% elif p.type == 'bool' %}
        {{ p.name }}: true
{% else %}
        {{ p.name }}: "CHANGEME"
{% endif %}
{% endfor %}
{% endif %}

{% endfor %}
