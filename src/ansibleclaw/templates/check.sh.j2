#!/usr/bin/env bash
# check.sh -- Prerequisite check for {{ module_name }}
# Generated by AnsibleClaw
set -euo pipefail

MODULE="{{ module_name }}"
{% set ns_parts = module_name.split('.') %}
{% set collection_fqcn = ns_parts[0] ~ '.' ~ ns_parts[1] if ns_parts | length >= 3 else '' %}
{% if collection_fqcn and collection_fqcn != 'ansible.builtin' %}
COLLECTION="{{ collection_fqcn }}"
{% else %}
COLLECTION=""
{% endif %}
PASS=0
FAIL=0

check() {
    local label="$1"
    shift
    if "$@" > /dev/null 2>&1; then
        echo "  [PASS] $label"
        PASS=$((PASS + 1))
    else
        echo "  [FAIL] $label"
        FAIL=$((FAIL + 1))
    fi
}

echo "Checking prerequisites for $MODULE ..."
echo

check "ansible CLI is installed" command -v ansible
check "ansible-doc CLI is installed" command -v ansible-doc
check "Module $MODULE is available" ansible-doc -t module "$MODULE"

if [[ -n "$COLLECTION" ]]; then
    check "Collection $COLLECTION is installed" \
        bash -c "ansible-galaxy collection list 2>/dev/null | grep -q '$COLLECTION'"
fi

echo
echo "--- CLI Mode ---"
echo "Results: $PASS passed, $FAIL failed"

if [[ $FAIL -gt 0 ]]; then
    echo
{% if collection_fqcn and collection_fqcn != 'ansible.builtin' %}
    echo "To fix:"
    echo "  pip install ansible-core        # install Ansible"
    if [[ -n "${AAP_CONTROLLER_URL:-}" ]]; then
        echo "  Collection {{ collection_fqcn }} may need to be added to your Execution Environment."
        echo "  Update execution-environment.yml and rebuild with ansible-builder."
    else
        echo "  ansible-galaxy collection install {{ collection_fqcn }}  # install collection"
    fi
{% else %}
    echo "To fix:"
    echo "  pip install ansible-core        # install Ansible"
{% endif %}
fi

echo
echo "--- AAP Mode ---"

AAP_PASS=0
AAP_FAIL=0

aap_check() {
    local label="$1"
    shift
    if "$@" > /dev/null 2>&1; then
        echo "  [PASS] $label"
        AAP_PASS=$((AAP_PASS + 1))
    else
        echo "  [FAIL] $label"
        AAP_FAIL=$((AAP_FAIL + 1))
    fi
}

aap_check "python3 is installed" command -v python3

{% if aap_url %}
# Baked AAP URL from AnsibleClaw config; env var overrides if set
AAP_URL="${AAP_CONTROLLER_URL:-{{ aap_url }}}"
{% else %}
AAP_URL="${AAP_CONTROLLER_URL:-}"
{% endif %}

if [[ -n "$AAP_URL" ]]; then
    echo "  [INFO] AAP Controller URL = ${AAP_URL}"
    aap_check "AAP_CONTROLLER_TOKEN is set" test -n "${AAP_CONTROLLER_TOKEN:-}"

    VERIFY_FLAG=""
{% if aap_verify_ssl == "false" %}
    VERIFY_FLAG="--insecure"
{% endif %}
    if [[ "${AAP_VERIFY_SSL:-{{ aap_verify_ssl | default('true') }}}" == "false" ]]; then
        VERIFY_FLAG="--insecure"
    fi
    aap_check "AAP Controller is reachable" \
        bash -c "curl -sf ${VERIFY_FLAG} -H 'Authorization: Bearer ${AAP_CONTROLLER_TOKEN:-}' '${AAP_URL}/api/v2/ping/' > /dev/null 2>&1 || curl -sf ${VERIFY_FLAG} -H 'Authorization: Bearer ${AAP_CONTROLLER_TOKEN:-}' '${AAP_URL}/api/controller/v2/ping/' > /dev/null 2>&1"

    aap_check "scripts/aap_run.py exists" test -f "$(dirname "$0")/aap_run.py"
else
    echo "  [SKIP] AAP_CONTROLLER_URL not set -- AAP mode not configured"
fi

echo
echo "AAP Results: $AAP_PASS passed, $AAP_FAIL failed"

if [[ $FAIL -gt 0 && $AAP_FAIL -gt 0 ]]; then
    echo
    echo "Neither CLI nor AAP mode is fully operational."
    exit 1
elif [[ $FAIL -gt 0 ]]; then
    echo
    echo "CLI mode has failures, but AAP mode is available."
elif [[ $AAP_FAIL -gt 0 && -n "$AAP_URL" ]]; then
    echo
    echo "AAP mode has failures, but CLI mode is available."
fi
